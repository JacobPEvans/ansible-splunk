#!/usr/bin/env python3
# {{ ansible_managed }}
#
# Splunk coldToFrozenScript: archive a bucket to S3-compatible object storage
# before Splunk removes it.
#
# CONTRACT WITH SPLUNK
#   argv[1] is the bucket directory. Exiting 0 tells Splunk the bucket is safe
#   to delete, so this script must not return 0 until every file is durably
#   stored. Any failure exits non-zero, which leaves the bucket in place on
#   disk. That is the safe direction: a stuck bucket costs space, a false
#   success costs the data.
#
# WHY PER-FILE UPLOAD RATHER THAN A TARBALL
#   Freezing happens precisely when a volume is under pressure. Building a
#   tarball first would need room for a second copy of the bucket at the moment
#   there is least room to spare. Uploading each file streams straight from
#   disk and needs no scratch space.
#
# WHY NO SDK
#   This runs inside the Splunk container, invoked by splunkd, with whatever
#   interpreter that image ships. Adding a dependency means installing into a
#   vendor image and keeping that working across upgrades. Request signing is a
#   documented algorithm and the standard library covers it, so there is
#   nothing to install and nothing to break on the next image bump.

import datetime
import hashlib
import hmac
import os
import sys
import tempfile
import time
import urllib.error
import urllib.request

# Object stores return transient 429/5xx under load. Without retry a momentary
# blip aborts the freeze, and while that direction is safe (the bucket stays on
# disk), it means space is not reclaimed and the same bucket fails again on the
# next pass. Retry the retryable statuses; fail fast on anything else, since a
# 403 will not improve by being asked again. Transport-level URLErrors are
# retried too - see the handler in put_object.
RETRY_STATUSES = frozenset({429, 500, 502, 503, 504})
MAX_ATTEMPTS = 5

# Socket timeout, applied PER SOCKET OPERATION - not to the whole transfer.
#
# That distinction is load-bearing. A bytes body makes http.client issue one
# sendall() for the entire object, and CPython enforces the socket timeout
# across a whole sendall(). Bucket files reach hundreds of MB, so on any link
# slow enough that one file takes longer than this budget, EVERY large bucket
# fails, exits non-zero, and is left on disk for retry forever - retention
# stops reclaiming, size caps stop binding, and the index volume fills until
# splunkd pauses indexing and refuses searches. That is not hypothetical; it is
# what this constant previously caused.
#
# Sending from a file object makes http.client transmit in blocksize chunks, so
# the budget applies to a single chunk. A chunk that cannot move within it is a
# genuinely stalled connection, which is the condition worth aborting on.
# Slow-but-progressing uploads now succeed at any file size, so this value does
# not need to scale with bucket size or link speed.
#
# It does need to tolerate the archive link's real behaviour. Measured against
# the offsite endpoint: 318 KB/s sustained, and bursty enough that a single
# chunk can sit unmoved for minutes without the connection being dead. At 60s
# every large bucket still died - on a stall rather than on total size. The
# budget is therefore a stall detector, not a throughput budget, and is sized
# for the worst observed stall. Worst case per file is this value multiplied by
# MAX_ATTEMPTS; a slow success beats a fast failure, because a failure leaves
# the bucket on disk forever.
REQUEST_TIMEOUT_SECONDS = {{ splunk_docker_frozen_upload_timeout_seconds | int }}

# Read size for the payload hash pass. The send granularity is separate and is
# http.client's own blocksize; it is left at the default deliberately, since
# overriding it means subclassing the connection class for no measurable gain.
HASH_BLOCK_SIZE = 1024 * 1024

# splunkd invokes coldToFrozenScript with a restricted environment - the
# compose-injected SPLUNK_FROZEN_S3_* vars a manual `docker exec` sees are not
# present on the path that actually matters. CONFIG_PATH is the fallback:
# simple KEY=value lines written by frozen_archive.yml next to this script,
# in the same config volume. The environment is checked first so the manual
# invocation used to canary this script keeps working unchanged.
CONFIG_PATH = "{{ splunk_docker_frozen_config_path }}"


def _read_config_file(path):
    """Parse simple KEY=value lines. Blank lines and '#' comments are ignored.

    Deliberately not INI/JSON - this script has no third-party dependencies
    and the config has no nesting, so the simplest parser that works is the
    right one.
    """
    values = {}
    try:
        with open(path, "r") as fh:
            lines = fh.readlines()
    except OSError:
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip()
    return values


_FILE_CONFIG = _read_config_file(CONFIG_PATH)


def _setting(name, default=""):
    value = os.environ.get(name, "")
    if value:
        return value
    return _FILE_CONFIG.get(name, default)


ENDPOINT = _setting("SPLUNK_FROZEN_S3_ENDPOINT")
BUCKET = _setting("SPLUNK_FROZEN_S3_BUCKET")
KEY_ID = _setting("SPLUNK_FROZEN_S3_KEY_ID")
APP_KEY = _setting("SPLUNK_FROZEN_S3_APP_KEY")


def _region_from_endpoint(endpoint):
    """Derive the signing region from the endpoint host.

    The region is part of the endpoint hostname, so carrying it as a separate
    setting just creates a second place to be wrong — and a mismatch fails
    signature verification with an error that says nothing about regions. A
    self-test against the real endpoint caught exactly that: a plausible
    default disagreed with the host the credential actually belongs to.
    """
    host = endpoint.split("://", 1)[-1].strip("/")
    parts = host.split(".")
    if len(parts) >= 3 and parts[0] == "s3":
        return parts[1]
    return ""


REGION = os.environ.get("SPLUNK_FROZEN_S3_REGION", "") or _region_from_endpoint(ENDPOINT)

# A single PUT is capped by the service. Buckets are normally far below this,
# but a bucket that exceeds it must fail loudly rather than upload a truncated
# object that looks like a successful archive.
MAX_SINGLE_PUT_BYTES = 5 * 1024 * 1024 * 1024


def log(msg):
    # splunkd captures stderr from this script into splunkd.log, so this is
    # where an operator will actually look when a freeze goes wrong.
    sys.stderr.write("cold_to_frozen: %s\n" % msg)
    sys.stderr.flush()


def _sign(key, msg):
    return hmac.new(key, msg.encode("utf-8"), hashlib.sha256).digest()


def _signing_key(secret, datestamp, region, service):
    k = _sign(("AWS4" + secret).encode("utf-8"), datestamp)
    k = _sign(k, region)
    k = _sign(k, service)
    return _sign(k, "aws4_request")


def _file_sha256(path):
    """Hash a file without holding it in memory.

    A bucket .tsidx can be hundreds of MB and this runs inside the Splunk
    container on a box that is, by definition, already under pressure when a
    freeze fires. Reading the whole file to hash it spikes RSS by the file size
    for no reason - the hash only needs a rolling read.
    """
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(HASH_BLOCK_SIZE), b""):
            digest.update(chunk)
    return digest.hexdigest()


def put_object(local_path, object_key):
    """Upload one file. Returns None on success, or an error string."""
    size = os.path.getsize(local_path)
    if size > MAX_SINGLE_PUT_BYTES:
        return "%s is %d bytes, above the single-request limit" % (local_path, size)

    # Two passes over the file: hash, then send. Both stream, so peak memory is
    # one block regardless of bucket size. SigV4 needs the payload hash up
    # front, and UNSIGNED-PAYLOAD is deliberately not used - the hash is the
    # only end-to-end integrity check this path has.
    payload_hash = _file_sha256(local_path)

    host = ENDPOINT.split("://", 1)[-1].rstrip("/")
    url = "%s/%s/%s" % (ENDPOINT.rstrip("/"), BUCKET, object_key)

    now = datetime.datetime.now(datetime.timezone.utc)
    amzdate = now.strftime("%Y%m%dT%H%M%SZ")
    datestamp = now.strftime("%Y%m%d")

    canonical_uri = "/%s/%s" % (BUCKET, object_key)
    canonical_headers = (
        "host:%s\nx-amz-content-sha256:%s\nx-amz-date:%s\n" % (host, payload_hash, amzdate)
    )
    signed_headers = "host;x-amz-content-sha256;x-amz-date"
    canonical_request = "\n".join(
        ["PUT", canonical_uri, "", canonical_headers, signed_headers, payload_hash]
    )

    scope = "%s/%s/s3/aws4_request" % (datestamp, REGION)
    string_to_sign = "\n".join(
        [
            "AWS4-HMAC-SHA256",
            amzdate,
            scope,
            hashlib.sha256(canonical_request.encode("utf-8")).hexdigest(),
        ]
    )
    signature = hmac.new(
        _signing_key(APP_KEY, datestamp, REGION, "s3"),
        string_to_sign.encode("utf-8"),
        hashlib.sha256,
    ).hexdigest()

    authorization = (
        "AWS4-HMAC-SHA256 Credential=%s/%s, SignedHeaders=%s, Signature=%s"
        % (KEY_ID, scope, signed_headers, signature)
    )

    try:
        # Send straight from the file handle. http.client then transmits in its
        # own blocksize chunks, so the socket timeout bounds ONE chunk instead
        # of the whole object - see REQUEST_TIMEOUT_SECONDS. Passing bytes here
        # instead is what made every large bucket unfreezable.
        with open(local_path, "rb") as fh:
            req = urllib.request.Request(url, data=fh, method="PUT")
            req.add_header("Host", host)
            req.add_header("x-amz-date", amzdate)
            req.add_header("x-amz-content-sha256", payload_hash)
            req.add_header("Authorization", authorization)
            # Required explicitly: urllib cannot infer a length from a file
            # object, and without it http.client falls back to chunked
            # transfer-encoding, which this SigV4 signature form does not cover.
            req.add_header("Content-Length", str(size))

            with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT_SECONDS) as resp:
                if resp.status not in (200, 201):
                    return "unexpected status %s for %s" % (resp.status, object_key)
    except urllib.error.HTTPError as exc:
        # Deliberately does not include the response body verbatim; it can echo
        # request metadata. The status and key are enough to diagnose.
        if exc.code in RETRY_STATUSES:
            return "retryable HTTP %s uploading %s" % (exc.code, object_key)
        return "HTTP %s uploading %s" % (exc.code, object_key)
    except urllib.error.URLError as exc:
        # Transport-level failure (DNS, connect, TLS, timeout) rather than an
        # HTTP response. HTTPError subclasses URLError, so this must stay below
        # the HTTPError handler. The restore path already retries these; the
        # freeze path not doing so was an inconsistency, and a freeze that gives
        # up on one blip leaves the bucket on a disk that is already tight.
        return "retryable URLError (%s) uploading %s" % (exc.reason, object_key)
    except Exception as exc:  # noqa: BLE001 - any failure must block deletion
        return "%s uploading %s" % (type(exc).__name__, object_key)
    return None


def put_object_with_retry(local_path, object_key):
    """Upload with bounded retry. Returns None on success or an error string."""
    err = None
    for attempt in range(MAX_ATTEMPTS):
        err = put_object(local_path, object_key)
        if err is None:
            return None
        if not err.startswith("retryable"):
            return err
        # Each attempt re-signs; a signature is bound to its timestamp and
        # cannot simply be replayed.
        time.sleep(2 ** attempt)
    return err


ARCHIVE_MARKER_NAME = "_ARCHIVE_COMPLETE"


def put_completion_marker(index_name, bucket_name, bucket_dir, files):
    """Publish the marker that makes a bucket's archive complete.

    Files are uploaded one at a time, so an interrupted freeze leaves a partial
    prefix in the store that looks exactly like an archived bucket from a LIST -
    the store already holds one such half-uploaded bucket from before this path
    worked. Restore must treat any bucket without this marker as incomplete
    rather than trusting object presence.

    Written last, on purpose: it is only true once every file above succeeded.
    """
    manifest = "".join(
        "%s %d\n" % (os.path.relpath(path, bucket_dir), os.path.getsize(path))
        for path in sorted(files)
    )
    body = "files=%d\n%s" % (len(files), manifest)

    # The marker is a few hundred bytes, so a temp file costs nothing - unlike
    # the bucket payload itself, which is streamed precisely to avoid needing
    # scratch space on a volume that is under pressure whenever a freeze runs.
    tmp_path = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", suffix=".manifest", delete=False
        ) as tmp:
            tmp.write(body)
            tmp_path = tmp.name
        return put_object_with_retry(
            tmp_path, "%s/%s/%s" % (index_name, bucket_name, ARCHIVE_MARKER_NAME)
        )
    finally:
        if tmp_path and os.path.exists(tmp_path):
            os.unlink(tmp_path)


def main():
    if len(sys.argv) < 2:
        log("no bucket path given")
        return 1
    bucket_dir = sys.argv[1].rstrip("/")

    if not os.path.isdir(bucket_dir):
        log("not a directory: %s" % bucket_dir)
        return 1

    missing = [
        name
        for name, value in (
            ("endpoint", ENDPOINT),
            ("bucket", BUCKET),
            ("key id", KEY_ID),
            ("app key", APP_KEY),
        )
        if not value
    ]
    if missing:
        # Refusing here is the point: without credentials the only alternative
        # is to let Splunk delete the bucket unarchived.
        log("refusing to freeze, missing config: %s" % ", ".join(missing))
        return 1

    # Splunk lays buckets out as <index>/<state>db/<bucket>, so the index name
    # is recoverable from the path and keeps archived objects grouped per index.
    parts = bucket_dir.split(os.sep)
    bucket_name = parts[-1]
    index_name = parts[-3] if len(parts) >= 3 else "unknown"

    files = []
    for root, _dirs, filenames in os.walk(bucket_dir):
        for filename in filenames:
            files.append(os.path.join(root, filename))

    if not files:
        log("no files under %s, refusing to report success" % bucket_dir)
        return 1

    log("archiving %s (%d files) from index %s" % (bucket_name, len(files), index_name))

    for path in files:
        rel = os.path.relpath(path, bucket_dir)
        object_key = "%s/%s/%s" % (index_name, bucket_name, rel)
        err = put_object_with_retry(path, object_key)
        if err:
            log("FAILED: %s - bucket left on disk for retry" % err)
            return 1

    err = put_completion_marker(index_name, bucket_name, bucket_dir, files)
    if err:
        # Every file is stored but the bucket is not yet provably complete.
        # Exiting non-zero keeps it on disk, which costs space and re-uploads
        # next pass - the cheap direction. Reporting success here would leave a
        # bucket that restore cannot verify.
        log("FAILED: %s - marker not written, bucket left on disk" % err)
        return 1

    log("archived %s (%d files)" % (bucket_name, len(files)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
