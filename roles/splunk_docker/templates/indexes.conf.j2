# Splunk indexes configuration
# Generated by Ansible

{#
  A cap is only rendered when one is set. Leaving it unset gives an uncapped
  volume, which is the behaviour that existed before volumes were introduced —
  no worse, and honest about enforcing nothing. Rendering a cap the filesystem
  cannot honour would be worse than both: it reads as a guarantee and silently
  is not one.
#}
[volume:hot_warm]
path = $SPLUNK_DB
{% if splunk_docker_volume_hot_warm_max_mb %}
maxVolumeDataSizeMB = {{ splunk_docker_volume_hot_warm_max_mb }}
{% endif %}

[volume:cold]
path = {{ splunk_docker_cold_dir }}
{% if splunk_docker_volume_cold_max_mb %}
maxVolumeDataSizeMB = {{ splunk_docker_volume_cold_max_mb }}
{% endif %}

{% for index in splunk_docker_indexes %}
[{{ index.name }}]
{% if (index.tier | default('small')) == 'large' %}
homePath = volume:hot_warm/{{ index.name }}/db
homePath.maxDataSizeMB = {{ index.home_max_size_mb }}
coldPath = volume:cold/{{ index.name }}/colddb
{% else %}
homePath = volume:hot_warm/{{ index.name }}/db
coldPath = volume:hot_warm/{{ index.name }}/colddb
{% endif %}
thawedPath = $SPLUNK_DB/{{ index.name }}/thaweddb
maxTotalDataSizeMB = {{ index.max_size_mb }}
frozenTimePeriodInSecs = {{ index.frozen_time_secs }}
{#
  coldToFrozenDir and coldToFrozenScript are mutually exclusive, and Splunk
  silently prefers the Dir form when both appear — which would disable the
  upload with no error anywhere. Render exactly one, never both.
#}
{% if splunk_docker_frozen_archive_enabled %}
coldToFrozenScript = "{{ splunk_docker_frozen_script_path }}"
{% elif splunk_docker_frozen_dir %}
coldToFrozenDir = {{ splunk_docker_frozen_dir }}
{% endif %}
{% if (index.datatype | default('event')) == 'metric' %}
datatype = metric
{% endif %}

{% endfor %}
